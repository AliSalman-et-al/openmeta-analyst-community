          <item row="3" column="0"><widget class="QLabel" name="point_size_label"><property name="text"><string>Point size:</string></property></widget></item>
          <item row="3" column="1"><widget class="QDoubleSpinBox" name="point_size_spin"><property name="minimum"><double>0.25</double></property><property name="maximum"><double>5.0</double></property><property name="singleStep"><double>0.25</double></property><property name="value"><double>1.0</double></property></widget></item>
