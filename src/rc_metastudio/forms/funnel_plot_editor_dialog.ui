 <class>FunnelPlotEditorDialog</class>
 <widget class="QDialog" name="FunnelPlotEditorDialog">
  <property name="windowTitle"><string>Edit funnel plot</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
