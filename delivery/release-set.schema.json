{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc-metastudio.org/schemas/release-set-v1.json",
  "type": "object",
  "required": ["schema_version", "product", "version", "channel", "trust_profile", "source", "policy_inputs", "release_targets", "targets", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "RC MetaStudio"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$"},
    "channel": {"enum": ["candidate", "rc", "stable", "withdrawn"]},
    "trust_profile": {"enum": ["unsigned-community", "macos-trusted", "trusted-signed"]},
    "source": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "policy_inputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "release_targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["windows-x64", "macos-arm64"]}
    },
    "targets": {"type": "object"},
    "history": {"type": "array"}
  },
  "additionalProperties": false
}
